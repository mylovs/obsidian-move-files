{
  "name": "obsidian-move-files",
  "version": "1.3.0",
  "description": "A plugin to help move referenced files in Obsidian notes",
  "main": "main.js",
  "scripts": {
    "dev": "esbuild main.ts --bundle --external:obsidian --external:electron --outfile=main.js --format=cjs --platform=node --watch",
    "build": "esbuild main.ts --bundle --external:obsidian --external:electron --outfile=main.js --format=cjs --platform=node",
    "lint": "eslint . --ext .ts"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "file management",
    "move files",
    "referenced files",
    "notes"
  ],
  "author": "mylovs",
  "authorUrl": "https://github.com/mylovs/obsidian-move-files",
  "fundingUrl": "https://github.com/mylovs/obsidian-move-files#funding",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "esbuild": "^0.28.0",
    "eslint": "^8.0.0",
    "obsidian": "^1.0.0",
    "obsidian-plugin-cli": "^0.9.0",
    "tslib": "^2.6.0",
    "typescript": "^5.3.0"
  }
}
  